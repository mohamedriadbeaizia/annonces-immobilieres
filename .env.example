# === Base de données (configuration locale, pas un secret) ===
# Lues par docker-compose.yml pour initialiser le conteneur
POSTGRES_USER="immo"
POSTGRES_PASSWORD="immo"
POSTGRES_DB="immo"
POSTGRES_PORT="5432"

# Lue par Prisma pour se connecter : mêmes valeurs que ci-dessus.
# Si vous en changez une, changez aussi l'autre.
DATABASE_URL="postgresql://immo:immo@localhost:5432/immo"

# === Better Auth ===
# VRAI secret, jamais commité. À générer : openssl rand -base64 32
BETTER_AUTH_SECRET="a-generer"
BETTER_AUTH_URL="http://localhost:3000"

# === Seed ===
# Mot de passe commun aux comptes de test (configuration de dev, pas un secret,
# documenté dans le README). 8 caractères minimum.
SEED_PASSWORD="demo1234"
